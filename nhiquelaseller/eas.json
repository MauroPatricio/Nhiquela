{
  "cli": {
    "version": ">= 12.4.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "node": "22.18.0",
      "env": {
        "EXPO_ANDROID_ENABLE_16K_PAGE_SUPPORT": "true",
        "NPM_CONFIG_LEGACY_PEER_DEPS": "true"
      }
    },
    "preview": {
      "distribution": "internal",
      "node": "22.18.0",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_ANDROID_ENABLE_16K_PAGE_SUPPORT": "true",
        "NPM_CONFIG_LEGACY_PEER_DEPS": "true"
      }
    },
    "production": {
      "autoIncrement": true,
      "node": "22.18.0",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_TARGET_SDK_VERSION": "36",
        "EXPO_ANDROID_ENABLE_16K_PAGE_SUPPORT": "true",
        "NPM_CONFIG_LEGACY_PEER_DEPS": "true"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
