{
  "expo": {
    "name": "nhiquelaseller",
    "slug": "nhiquelap",
    "version": "1.0.0",
    "owner": "mpatricio",
    "orientation": "portrait",
    "icon": "./assets/nhiquela3.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/nhiquela3.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "platforms": [
      "ios",
      "android"
    ],
    "android": {
      "package": "com.mpatricio.nhiquelap",
      "googleServicesFile": "./google-services.json",
      "icon": "./assets/nhiquela3.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/nhiquela3.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "POST_NOTIFICATIONS",
        "VIBRATE",
        "WAKE_LOCK"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBipLnxa_lqw1IUKqQovRe_oQpeVvjGZ4s"
        }
      }
    },
    "notification": {
      "icon": "./assets/nhiquela3.png",
      "color": "#7F00FF",
      "androidCollapsedTitle": "NhiquelaPRO"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mpatricio.nhiquelap",
      "icon": "./assets/nhiquela3.png",
      "infoPlist": {
        "NSCameraUsageDescription": "NhiquelaPRO precisa acessar sua câmera para upload de imagens.",
        "NSPhotoLibraryUsageDescription": "NhiquelaPRO precisa acessar sua galeria para upload de fotos.",
        "NSLocationWhenInUseUsageDescription": "Nhiquela usa sua localização para entregas e mapas.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Nhiquela precisa da sua localização para rastreamento.",
        "UIBackgroundModes": [
          "fetch",
          "remote-notification"
        ],
        "NSUserTrackingUsageDescription": "O app utiliza dados para melhorar a experiência."
      },
      "config": {
        "googleMapsApiKey": "AIzaSyBipLnxa_lqw1IUKqQovRe_oQpeVvjGZ4s"
      }
    },
    "web": {
      "favicon": "./assets/nhiquela3.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0",
            "softwareKeyboardLayoutMode": "pan",
            "enableProguardInReleaseBuilds": false
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "NhiquelaPRO precisa de acesso à câmera."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "NhiquelaPRO usa localização para mapas e entregas."
        }
      ],
      "expo-notifications",
      "expo-font"
    ],
    "extra": {
      "googleMapsApiKey": "AIzaSyBipLnxa_lqw1IUKqQovRe_oQpeVvjGZ4s",
      "firebase": {
        "apiKey": "AIzaSyBU7yO9-ZLoxZ8S-sBxfLHeyjMa0KB4Aus",
        "authDomain": "nhiquela-4bfb5.firebaseapp.com",
        "projectId": "nhiquela-4bfb5",
        "storageBucket": "nhiquela-4bfb5.appspot.com",
        "messagingSenderId": "127489638441",
        "appId": "1:127489638441:web:27d4f40299cb1324ca9c38",
        "measurementId": "G-FN5JGWV1S4"
      },
      "eas": {
        "projectId": "3955dd7f-ad17-497a-966b-33dfae1b0b18"
      }
    },
    "runtimeVersion": "1.0.0"
  }
}